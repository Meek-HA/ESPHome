  - platform: template
    name: "Device ID"
    id: device_id_text
    icon: mdi:identifier
    entity_category: ""
    update_interval: never   # static: published once at boot
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 5
    lambda: |-
      std::string mac = get_mac_address();
      std::string id_text = mac.substr(mac.length() - 4);
      for (auto &c : id_text) {
        c = toupper(static_cast<unsigned char>(c));
      }
      return {id_text};

  - platform: template
    name: "WiFi Reset Status"
    id: wifi_reset_status_text
    icon: mdi:wifi-alert
    entity_category: ""
    update_interval: never   # updated by the wifi_reset_* scripts
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 111
    lambda: |-
      if (id(wifi_reset_armed)) {
        return {"Press 'Reset WiFi Settings' again within 10 s to confirm"};
      }
      return {"Idle"};

