    id: led_effect_select
    entity_category: ""
    icon: mdi:flash-outline
    optimistic: true
    restore_value: true
    initial_option: "Off"
    options:
      - "Off"
      - "Pulse"
      - "Strobe"
      - "Flicker"
      - "Scan"
      - "Rainbow"
      - "Color Wipe"
      - "Twinkle"
      - "Random Twinkle"
      - "Fireworks"
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 7
    # CHANGED: one action instead of 10 if-blocks.
    on_value:
      then:
        - light.turn_on:
            id: led_strip
            brightness: 100%
            effect: !lambda |-
              std::string selected(id(led_effect_select).current_option());
              return selected == "Off" ? std::string("None") : selected;
        - if:
            condition:
              lambda: 'return std::string(id(led_effect_select).current_option()) == "Off";'
            then:
              - script.execute:
                  id: sync_leds_to_outputs
                  which: 0

