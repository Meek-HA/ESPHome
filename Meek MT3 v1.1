mqtt:
  id: mqtt_client
  broker: "mqtt.meek-io.com"
  port: 1883
  username: ""
  password: ""
  enable_on_boot: false
  reboot_timeout: 0s
  # ADDED: the default ("legacy") unique ID is only "ESP" + type + name
  # (e.g. ESPbuttonstop_speaker), which collides with other Meek devices in
  # Home Assistant. "mac" puts this device's MAC address in the unique ID.
  discovery_unique_id_generator: mac
  # MQTT Status is event-driven instead of polled every 5 s.
  on_connect:
    - text_sensor.template.publish:
        id: mqtt_status_text
        state: "Connected"
  on_disconnect:
    - text_sensor.template.publish:
        id: mqtt_status_text
        state: "Disconnected"
  # Kept so USE_MQTT_TLS is defined and the cert setters get generated.
  # The script below clears/overrides it at runtime based on the security select.
  certificate_authority: ${mqtt_ca_cert}
  skip_cert_cn_check: false

globals:
  - id: buzzer_boot_lockout
    type: bool
    restore_value: no
    initial_value: "true"

  - id: buttons_locked
    type: bool
    restore_value: no
    initial_value: "false"

  # Set for 1 s after every Touch IC's switch change; blocks button presses
  - id: touch_freeze
    type: bool
    restore_value: no
    initial_value: "false"

  - id: first_boot_completed
    type: bool
    restore_value: true
    initial_value: "false"

  - id: wifi_reset_armed
    type: bool
    restore_value: no
    initial_value: "false"

  - id: mqtt_password_real
    type: std::string
    restore_value: true
    initial_value: '""'

script:
  - id: apply_mqtt_settings
    mode: restart
    then:
      - lambda: |-
          static bool applied = false;
          if (applied) {
            return;
          }
          applied = true;

          id(mqtt_client).disable();

          const std::string broker = id(mqtt_broker_text).state;
          const std::string port_text = id(mqtt_port_text).state;
          const std::string security = id(mqtt_security_select).current_option();

          if (broker.empty() || port_text.empty()) {
            ESP_LOGE("mqtt_config", "MQTT disabled: broker or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("mqtt_config", "MQTT disabled: port contains non-digit characters.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("mqtt_config", "MQTT disabled: port is outside the valid range.");
              return;
            }
          }

          if (port_value < 1 || port_value > 65535) {
            ESP_LOGE("mqtt_config", "MQTT disabled: port must be between 1 and 65535.");
            return;
          }

          id(mqtt_client).set_broker_address(broker);
          id(mqtt_client).set_broker_port(static_cast<uint16_t>(port_value));
          id(mqtt_client).set_username(id(mqtt_username_text).state);
          id(mqtt_client).set_password(id(mqtt_password_real));

          if (security == "MQTTS (Secure/TLS)") {
            // Same certificate as in `mqtt: certificate_authority`, from the
            // `mqtt_ca_cert` substitution. ESPHome indents every line of a
            // lambda, which would put spaces inside the PEM body (mbedTLS error
            // -0x112C), so leading whitespace is stripped from each line here.
            // Static: the MQTT client keeps the pointer, so it must stay alive.
            static std::string MQTT_CA_CERT;
            if (MQTT_CA_CERT.empty()) {
              const char *raw = R"CERT(${mqtt_ca_cert})CERT";
              bool at_line_start = true;
              for (const char *c = raw; *c != '\0'; c++) {
                if (*c == '\n') {
                  at_line_start = true;
                } else if (at_line_start && (*c == ' ' || *c == '\t' || *c == '\r')) {
                  continue;
                } else {
                  at_line_start = false;
                }
                MQTT_CA_CERT += *c;
              }
            }

            id(mqtt_client).set_ca_certificate(MQTT_CA_CERT.c_str());
            id(mqtt_client).set_skip_cert_cn_check(false);
            ESP_LOGI("mqtt_config", "MQTTS enabled: TLS will be used.");
          } else {
            // Patched component: an empty CA certificate forces the plain TCP transport.
            id(mqtt_client).set_ca_certificate("");
            id(mqtt_client).set_skip_cert_cn_check(true);
            ESP_LOGI("mqtt_config", "MQTT enabled: unencrypted connection will be used.");
          }

          id(mqtt_client).enable();

  - id: play_manual_buzzer_tone
    mode: restart
    then:
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout) && id(buzzer_pwm_volume).state > 0;'
          then:
            - rtttl.stop
            - output.turn_on: buzzer_output
            - output.ledc.set_frequency:
                id: buzzer_output
                frequency: !lambda 'return id(buzzer_pwm_frequency).state;'
            - output.set_level:
                id: buzzer_output
                level: !lambda |-
                  return id(buzzer_pwm_volume).state / 100.0f;
            - delay: !lambda |-
                return static_cast<uint32_t>(id(buzzer_tone_duration).state);
            - output.turn_off: buzzer_output

  - id: wifi_reset_arm_timer
    mode: restart
    then:
      - lambda: |-
          id(wifi_reset_armed) = true;
      - component.update: wifi_reset_status_text
      - delay: 10s
      - lambda: |-
          id(wifi_reset_armed) = false;
      - component.update: wifi_reset_status_text

  # Freezes the buttons for 1 s whenever the Touch IC's switch changes state.
  # mode: restart -> a new toggle during the window restarts the 1 s.
  - id: touch_ic_freeze
    mode: restart
    then:
      - lambda: |-
          id(touch_freeze) = true;
      - delay: 1s
      - lambda: |-
          id(touch_freeze) = false;

  # Sets the default colours/brightness of all six partition lights.
  # Used on first boot and by "Reset Settings" (was duplicated in both).
  - id: apply_default_led_colors
    mode: restart
    then:
      - lambda: |-
          // "ON" lights: purple, 40 %
          id(led1_on).turn_on().set_brightness(0.4f).set_red(1.0f).set_green(0.0f).set_blue(1.0f).perform();
          id(led2_on).turn_on().set_brightness(0.4f).set_red(1.0f).set_green(0.0f).set_blue(1.0f).perform();
          id(led3_on).turn_on().set_brightness(0.4f).set_red(1.0f).set_green(0.0f).set_blue(1.0f).perform();
          // "OFF" lights: warm white, 30 %
          id(led1_off).turn_on().set_brightness(0.3f).set_red(1.0f).set_green(0.996f).set_blue(0.98f).perform();
          id(led2_off).turn_on().set_brightness(0.3f).set_red(1.0f).set_green(0.996f).set_blue(0.98f).perform();
          id(led3_off).turn_on().set_brightness(0.3f).set_red(1.0f).set_green(0.996f).set_blue(0.98f).perform();

  # Shows the "on" or "off" colour on the LED(s) according to the output state.
  # which: 0 = all three LEDs, 1..3 = only that LED.
  - id: sync_leds_to_outputs
    mode: restart
    parameters:
      which: int
    then:
      - lambda: |-
          if (which == 0 || which == 1) {
            if (id(output_1).state) id(led1_on).turn_on().perform(); else id(led1_off).turn_on().perform();
          }
          if (which == 0 || which == 2) {
            if (id(output_2).state) id(led2_on).turn_on().perform(); else id(led2_off).turn_on().perform();
          }
          if (which == 0 || which == 3) {
            if (id(output_3).state) id(led3_on).turn_on().perform(); else id(led3_off).turn_on().perform();
          }

  # Drives the physical relays. A relay is ON when its output is logically ON,
  # or ALWAYS when the output is in "Zigbee" mode (keeps the Zigbee lamp powered).
  # which: 0 = all three, 1..3 = only that output.
  - id: sync_relays
    mode: restart
    parameters:
      which: int
    then:
      - lambda: |-
          if (which == 0 || which == 1) {
            const bool zigbee = std::string(id(output_1_mode).current_option()) == "Zigbee";
            if (zigbee || id(output_1).state) id(relay_1).turn_on(); else id(relay_1).turn_off();
          }
          if (which == 0 || which == 2) {
            const bool zigbee = std::string(id(output_2_mode).current_option()) == "Zigbee";
            if (zigbee || id(output_2).state) id(relay_2).turn_on(); else id(relay_2).turn_off();
          }
          if (which == 0 || which == 3) {
            const bool zigbee = std::string(id(output_3_mode).current_option()) == "Zigbee";
            if (zigbee || id(output_3).state) id(relay_3).turn_on(); else id(relay_3).turn_off();
          }

text:
  - platform: template
    name: "MQTT Broker"
    id: mqtt_broker_text
    discovery: false   # hidden from Home Assistant, still in the web UI
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: "mqtt.meek-io.com"
    max_length: 64
    icon: mdi:server-network
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 10

  - platform: template
    name: "MQTT Port"
    id: mqtt_port_text
    discovery: false   # hidden from Home Assistant, still in the web UI
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: "1883"
    min_length: 1
    max_length: 5
    icon: mdi:numeric
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 20

  - platform: template
    name: "MQTT Username"
    id: mqtt_username_text
    discovery: false   # hidden from Home Assistant, still in the web UI
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: ""
    max_length: 64
    icon: mdi:account-network
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 30

  - platform: template
    name: "MQTT Password"
    id: mqtt_password_text
    discovery: false   # hidden from Home Assistant, still in the web UI
    entity_category: ""
    mode: text
    optimistic: true
    initial_value: ""
    max_length: 64
    icon: mdi:form-textbox-password
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 40
    set_action:
      - lambda: |-
          id(mqtt_password_real) = x;
          if (x.empty()) {
            id(mqtt_password_text).publish_state("");
          } else {
            id(mqtt_password_text).publish_state("********");
          }

  - platform: template
    name: "RTTTL Melody"
    id: rtttl_melody_text
    entity_category: ""
    mode: text
    # Not optimistic: set_action publishes the state itself (see below).
    restore_value: true
    # A single space = "blank". An empty string is never published, which makes
    # Home Assistant show "unknown".
    initial_value: " "
    max_length: 255
    icon: mdi:music-note-plus
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 60
    set_action:
      - rtttl.stop
      - lambda: |-
          // Publish a single space instead of an empty string (see initial_value).
          id(rtttl_melody_text).publish_state(x.empty() ? std::string(" ") : x);
      - if:
          condition:
            lambda: 'return x.find_first_not_of(" \t") != std::string::npos;'
          then:
            - rtttl.play: !lambda 'return x;'

button:
  - platform: template
    name: "Save and Reboot"
    id: save_and_reboot_button
    discovery: false   # hidden from Home Assistant, still in the web UI
    icon: mdi:content-save-alert
    entity_category: ""
    on_press:
      - lambda: |-
          ESP_LOGI("save_reboot", "Saving preferences and rebooting...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("save_reboot", "Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 50

  - platform: template
    name: "Restart MDT3 ESP32"
    id: restart_mdt3_button
    entity_category: ""
    icon: mdi:restart
    on_press:
      - lambda: |-
          ESP_LOGI("restart", "Saving all preferences before rebooting...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("restart", "All preferences saved. Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 90

  - platform: template
    name: "Reset WiFi Settings"
    id: reset_wifi_settings_button
    discovery: false   # hidden from Home Assistant, still in the web UI
    icon: mdi:wifi-cog
    entity_category: ""
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 110
    on_press:
      - if:
          condition:
            lambda: 'return id(wifi_reset_armed);'
          then:
            - script.stop: wifi_reset_arm_timer
            - lambda: |-
                ESP_LOGW("wifi_reset", "Confirmed. Forgetting saved WiFi settings...");
                const uint32_t hash_with_sta = App.get_config_version_hash();
                const uint32_t hash_without_sta = 88491487UL;
                const uint32_t keys[4] = {hash_with_sta, hash_with_sta + 1,
                                          hash_without_sta, hash_without_sta + 1};
                for (uint32_t key : keys) {
                  auto pref = global_preferences->make_preference<uint8_t>(key, true);
                  uint8_t invalid = 0;
                  pref.save(&invalid);
                }
                global_preferences->sync();
            - delay: 500ms
            - lambda: |-
                ESP_LOGW("wifi_reset", "WiFi settings forgotten. Rebooting now...");
                esp_restart();
          else:
            - logger.log:
                level: WARN
                format: "WiFi reset armed. Press the button again within 10 seconds to confirm."
            - script.execute: wifi_reset_arm_timer

  - platform: template
    name: "Play PWM Tone"
    id: play_buzzer_tone_button
    icon: mdi:play-circle
    entity_category: ""
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 40
    on_press:
      - script.execute: play_manual_buzzer_tone

  - platform: template
    name: "Play Selected Melody"
    id: play_selected_melody_button
    icon: mdi:play-circle-outline
    entity_category: ""
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 90
    on_press:
      - rtttl.stop
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout);'
          then:
            # CHANGED: one lookup table instead of 16 if-blocks.
            # The names must match the options of the "Speaker Melody" select.
            - lambda: |-
                static const struct { const char *name; const char *tune; } MELODIES[] = {
