# Loads the patched MQTT component from /config/components/mqtt
# (an empty CA certificate forces plain TCP instead of TLS)
external_components:
  - source:
      type: local
      path: components
    components: [mqtt]

ota:
  - platform: esphome
    
wifi:
  reboot_timeout: 0s
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  on_connect:
    then:
      - script.execute: apply_mqtt_settings
      - component.update: ip_ipv4
  ap:
    ssid: Meek_MT3
    password: www.meek-io.com
captive_portal:
  
esphome:
  name: meek-mt3
  friendly_name: Meek MT3
  name_add_mac_suffix: true

  on_boot:
    - priority: 700
      then:
        - lambda: |-
            id(buttons_locked) = true;

        - switch.turn_off: touch_ics_output
        - delay: 5s
        - switch.turn_on: touch_ics_output
        - delay: 1s

        - lambda: |-
            id(buttons_locked) = false;
            id(buzzer_boot_lockout) = false;

        - if:
            condition:
              lambda: 'return !id(first_boot_completed);'
            then:
              - script.execute: apply_default_led_colors
              - lambda: |-
                  id(first_boot_completed) = true;

        - script.execute:
            id: sync_leds_to_outputs
            which: 0

        # Restore masked password display after components are ready
        - delay: 2s
        - lambda: |-
            if (!id(mqtt_password_real).empty()) {
              id(mqtt_password_text).publish_state("********");
            } else {
              id(mqtt_password_text).publish_state("");
            }

    # Static / event-driven values are published ONCE here (after all components
    # are set up). ESPHome re-sends the current state of every entity to MQTT on
    # each (re)connect by itself, so they never need to be polled.
    - priority: -100
      then:
        - script.execute:
            id: sync_relays
            which: 0
        - lambda: |-
            // An old saved empty melody would otherwise stay unpublished ("unknown" in HA).
            if (id(rtttl_melody_text).state.empty()) {
              id(rtttl_melody_text).publish_state(" ");
            }
        - component.update: esphome_version_text
        - component.update: firmware_build_date_text
        - component.update: device_id_text
        - component.update: wifi_reset_status_text
        - text_sensor.template.publish:
            id: mqtt_status_text
            state: "Disconnected"

esp32:
  board: esp32dev
  variant: esp32
  framework:
    type: esp-idf

