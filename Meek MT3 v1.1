light:
  - platform: esp32_rmt_led_strip
    name: "LED Strip"
    id: led_strip
    pin: GPIO13
    chipset: SK6812
    num_leds: 3
    channel_colors: GRB
    internal: true
    restore_mode: RESTORE_DEFAULT_ON
    effects:
      - pulse:
          name: "Pulse"
          transition_length: 1s
          update_interval: 1s
          min_brightness: 0%
          max_brightness: 100%
      - strobe:
          name: "Strobe"
          colors:
            - state: true
              brightness: 100%
              duration: 200ms
            - state: false
              duration: 200ms
      - flicker:
          name: "Flicker"
          intensity: 5%
      - addressable_scan:
          name: "Scan"
          move_interval: 150ms
          scan_width: 1
      - addressable_rainbow:
          name: "Rainbow"
          speed: 10
          width: 3
      - addressable_color_wipe:
          name: "Color Wipe"
          colors:
            - red: 100%
              green: 0%
              blue: 0%
              num_leds: 1
            - red: 0%
              green: 100%
              blue: 0%
              num_leds: 1
            - red: 0%
              green: 0%
              blue: 100%
              num_leds: 1
          add_led_interval: 200ms
          reverse: false
      - addressable_twinkle:
          name: "Twinkle"
          twinkle_probability: 5%
          progress_interval: 32ms
      - addressable_random_twinkle:
          name: "Random Twinkle"
          twinkle_probability: 5%
          progress_interval: 32ms
      - addressable_fireworks:
          name: "Fireworks"
          update_interval: 32ms
          spark_probability: 10%
          use_random_color: true
          fade_out_rate: 120

  - platform: partition
    name: "LED 1 ON"
    id: led1_on
    segments:
      - id: led_strip
        from: 0
        to: 0
    icon: mdi:led-on
    entity_category: ""
    restore_mode: RESTORE_DEFAULT_ON
