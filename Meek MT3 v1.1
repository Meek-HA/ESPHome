switch:
  - platform: gpio
    id: touch_ics_output
    name: "Touch IC's"
    pin: GPIO23
    restore_mode: RESTORE_DEFAULT_OFF
    icon: mdi:gesture-tap
    on_turn_on:
      - script.execute: touch_ic_freeze
    on_turn_off:
      - script.execute: touch_ic_freeze
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 19

  # Physical relay of output 1. Internal: it is driven by the sync_relays script
  # (ON when the output is logically ON, or always ON in "Zigbee" mode).
  - platform: gpio
    id: relay_1
    name: "Output1 Relay"
    internal: true
    pin: GPIO18
    restore_mode: RESTORE_DEFAULT_ON

  # Physical relay of output 2. Internal: it is driven by the sync_relays script
  # (ON when the output is logically ON, or always ON in "Zigbee" mode).
  - platform: gpio
    id: relay_2
    name: "Output2 Relay"
    internal: true
    pin: GPIO19
    restore_mode: RESTORE_DEFAULT_ON

  # Physical relay of output 3. Internal: it is driven by the sync_relays script
  # (ON when the output is logically ON, or always ON in "Zigbee" mode).
  - platform: gpio
    id: relay_3
    name: "Output3 Relay"
    internal: true
    pin: GPIO21
    restore_mode: RESTORE_DEFAULT_ON

  # Logical state of output 1: what the buttons toggle, what the LED shows and
  # what Home Assistant sees. In "Zigbee" mode the relay stays on regardless.
  - platform: template
    id: output_1
    name: "Output1"
    optimistic: true
    restore_mode: RESTORE_DEFAULT_ON
    entity_category: ""
    icon: mdi:lamp
    on_turn_on:
      - script.execute:
          id: sync_relays
          which: 1
      - script.execute:
          id: sync_leds_to_outputs
          which: 1
      - script.execute: play_manual_buzzer_tone
    on_turn_off:
      - script.execute:
          id: sync_relays
          which: 1
      - script.execute:
          id: sync_leds_to_outputs
          which: 1
      - script.execute: play_manual_buzzer_tone
    web_server:
      sorting_group_id: sensors_control_group
