                const std::string selected(id(buzzer_melody).current_option());
                for (const auto &m : MELODIES) {
                  if (selected == m.name) {
                    id(rtttl_buzzer).play(m.tune);
                    return;
                  }
                }
                ESP_LOGW("melody", "No tune defined for '%s'", selected.c_str());

  - platform: template
    name: "Play Entered RTTTL Melody"
    id: play_entered_rtttl_melody_button
    icon: mdi:music-note-plus
    entity_category: ""
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 70
    on_press:
      - rtttl.stop
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout);'
          then:
            - if:
                condition:
                  lambda: 'return id(rtttl_melody_text).state.find_first_not_of(" \t") != std::string::npos;'
                then:
                  - rtttl.play: !lambda 'return id(rtttl_melody_text).state;'
                else:
                  - logger.log:
                      level: WARN
                      format: "No RTTTL melody entered."

  - platform: template
    name: "Stop Speaker"
    id: stop_buzzer_button
    icon: mdi:stop-circle-outline
    entity_category: ""
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 100
    on_press:
      - rtttl.stop

  - platform: template
    name: "Reset Settings"
    id: reset_settings_button
    discovery: false   # hidden from Home Assistant, still in the web UI
    icon: mdi:restore
    entity_category: ""
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 95
    on_press:
      - text.set:
          id: mqtt_broker_text
          value: "mqtt.meek-io.com"
      - text.set:
          id: mqtt_port_text
          value: "1883"
      - text.set:
          id: rtttl_melody_text
          value: ""
      - number.set:
          id: buzzer_pwm_frequency
          value: 4000
      - number.set:
          id: buzzer_tone_duration
          value: 100
      - number.set:
          id: buzzer_pwm_volume
          value: 25
      - number.set:
          id: buzzer_volume
          value: 25
      - select.set:
          id: buzzer_melody
          option: "Mario"
      - select.set:
          id: led_effect_select
          option: "Off"
      - select.set:
          id: output_1_mode
          option: "Normal"
      - select.set:
          id: output_2_mode
          option: "Normal"
      - select.set:
          id: output_3_mode
          option: "Normal"
      - script.execute: apply_default_led_colors
      - lambda: |-
          id(first_boot_completed) = false;
          id(mqtt_password_real) = "";
          id(mqtt_password_text).publish_state("");
      - lambda: |-
          ESP_LOGI("reset_settings", "Resetting settings to factory defaults...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("reset_settings", "Rebooting to apply factory defaults...");
          esp_restart();

