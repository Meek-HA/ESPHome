# ----------------- BUTTONS -----------------

binary_sensor:
  - platform: gpio
    id: button_1
    name: "Button1"
    pin:
      number: GPIO22
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on_off: 10ms
    entity_category: diagnostic
    icon: mdi:gesture-tap-button
    on_press:
      - if:
          condition:
            lambda: 'return !id(buttons_locked);'
          then:
