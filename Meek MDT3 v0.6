    segments:
      - id: led_strip
        from: 1
        to: 1
    icon: mdi:led-on
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 10

  - platform: partition
    name: "LED 2 OFF"
    id: led2_off
    segments:
      - id: led_strip
        from: 1
        to: 1
    icon: mdi:led-off
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 11

  - platform: partition
    name: "LED 3 ON"
    id: led3_on
    segments:
      - id: led_strip
        from: 2
        to: 2
    icon: mdi:led-on
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 12

  - platform: partition
    name: "LED 3 OFF"
    id: led3_off
    segments:
      - id: led_strip
        from: 2
        to: 2
    icon: mdi:led-off
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 13

# ----------------- SPEAKER / RTTTL -----------------

output:
  - platform: ledc
    pin: GPIO25
    id: buzzer_output
    frequency: 2000 Hz

rtttl:
  id: rtttl_buzzer
  output: buzzer_output
  gain: 50%

number:
  - platform: template
    name: "Speaker PWM Frequency"
    id: buzzer_pwm_frequency
    entity_category: config
    icon: mdi:sine-wave
    optimistic: true
    restore_value: true
    initial_value: 2000
    min_value: 500
    max_value: 5000
    step: 25
    unit_of_measurement: "Hz"
    mode: slider
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 10
    set_action:
      - output.ledc.set_frequency:
          id: buzzer_output
          frequency: !lambda 'return x;'

  - platform: template
    name: "Speaker PWM Duration"
    id: buzzer_tone_duration
    entity_category: config
    icon: mdi:timer-outline
    optimistic: true
    restore_value: true
    initial_value: 500
    min_value: 10
    max_value: 5000
    step: 50
    unit_of_measurement: "ms"
    mode: slider
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 20

  - platform: template
    name: "Speaker PWM Volume"
    id: buzzer_pwm_volume
    entity_category: config
    icon: mdi:volume-medium
    optimistic: true
    restore_value: true
    initial_value: 50
    min_value: 0
    max_value: 100
    step: 1
    unit_of_measurement: "%"
    mode: slider
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 30

  - platform: template
    name: "Speaker Melody Volume"
    id: buzzer_volume
    entity_category: config
    icon: mdi:volume-high
    optimistic: true
    restore_value: true
    initial_value: 50
    min_value: 0
    max_value: 100
    step: 1
    mode: slider
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 50
    set_action:
      - lambda: |-
          id(rtttl_buzzer).set_gain(x / 100.0f);

select:
  - platform: template
    name: "Speaker Melody"
    id: buzzer_melody
    entity_category: config
    icon: mdi:music-note
    optimistic: true
    restore_value: true
    initial_option: "Mario"
    options:
      - "Mario"
      - "Nokia"
      - "Alarm"
      - "Star Wars"
      - "Imperial March"
      - "Happy Birthday"
      - "Rudolph the Red Nosed Reindeer"
      - "Door Bell"
      - "Office Ring"
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 80

  - platform: template
    name: "LED Effect"
    id: led_effect_select
    entity_category: config
    icon: mdi:led-variant
    optimistic: true
    restore_value: true
    initial_option: "Off"
    options:
      - "Off"
      - "Pulse"
      - "Strobe"
      - "Flicker"
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 7
    on_value:
      then:
        - if:
            condition:
              lambda: 'return id(led_effect_select).current_option() == "Off";'
            then:
              - light.turn_off: led_strip

        - if:
            condition:
              lambda: 'return id(led_effect_select).current_option() == "Pulse";'
            then:
              - light.turn_on:
                  id: led_strip
                  effect: "Pulse"
                  brightness: 100%

        - if:
            condition:
              lambda: 'return id(led_effect_select).current_option() == "Strobe";'
            then:
              - light.turn_on:
                  id: led_strip
                  effect: "Strobe"
                  brightness: 100%

        - if:
            condition:
              lambda: 'return id(led_effect_select).current_option() == "Flicker";'
            then:
              - light.turn_on:
                  id: led_strip
                  effect: "Flicker"
                  brightness: 100%

