      - rtttl.stop
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout);'
          then:
            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Mario";'
                then:
                  - rtttl.play: "Mario:d=16,o=5,b=100:32p,e6,e6,p,e6,p,c6,e6,p,g6,8p,p,g,8p,32p,c6,8p,g,8p,e,8p,a,p,b,p,a#,a,p,g,e6,g6,a6,p,f6,g6,p,e6,p,c6,d6,b,4p,g6,f#6,f6,d#6,p,e6,p,g#,a,c6,p,a,c6,d6,8p,8d#6,p,d6,8p,8c6"

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Nokia";'
                then:
                  - rtttl.play: "NokiaTune:d=16,o=5,b=64:32f6,32d#6,g,a,32d6,32c6,d#,f,32c6,32a#,d,f,8a#."

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Alarm";'
                then:
                  - rtttl.play: "alarm:d=8,o=5,b=180:c,e,g,c6,g,e,c,e,g,c6,g,e"

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Star Wars";'
                then:
                  - rtttl.play: "starwars:d=8,o=6,b=180:f5,f5,f5,2a#5.,2f.,d#,d,c,2a#.,4f.,d#,d,c,2a#.,4f.,d#,d,d#,2c,4p,f5,f5,f5,2a#5.,2f.,d#,d,c,2a#.,4f.,d#,d,c,2a#.,4f.,d#,d,d#,2c"

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Imperial March";'
                then:
                  - rtttl.play: "Imperial March:o=5,d=4,b=120:e,e,e,8c,16p,16g,e,8c,16p,16g,e,p,b,b,b,8c6,16p,16g,d#,8c,16p,16g,e,8"

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Happy Birthday";'
                then:
                  - rtttl.play: "Happy Birthday:o=5,d=4,b=125:8g.,16g,a,g,c6,2b,8g.,16g,a,g,d6,2c6,8g.,16g,g6,e6,c6,b,a,8f6.,16f6,e6,c6,d6,2c6,8g.,16g,a,g,c6,2b,8g.,16g,a,g,d6,2c6,8g.,16g,g6,e6,c6,b,a,8f6.,16f6,e6,c6,d6,2c6"

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Rudolph the Red Nosed Reindeer";'
                then:
                  - rtttl.play: "Rudolph the Red Nosed Raindeer:o=5,d=8,b=250,b=250:g,4a,g,4e,4c6,4a,2g.,g,a,g,a,4g,4c6,2b.,4p,f,4g,f,4d,4b,4a,2g.,g,a,g,a,4g,4a,2e.,4p,g,4a,a,4e,4c6,4a,2g.,g,a,g,a,4g,4c6,2b.,4p,f,4g,f,4d,4b,4a,2g.,g,a,g,a,4g,4d6,2c6.,4p,4a,4a,4c6,4a,4g,4e,2g,4d,4e,4g,4a,4b,4b,2b,4c6,4c6,4b,4a,4g,4f,2d,g,4a,g,4e,4c6,4a,2g.,g,a,g,a,4g,4c6,2b.,4p,f,4g,f,4d,4b,4a,2g.,4g,4a,4g,4a,2g,2d6,1c6.."

            - if:
                condition:
                  lambda: 'return id(buzzer_melody).current_option() == "Door Bell";'
                then:
                  - rtttl.play: "Door Bell:d=16,o=6,b=120:e,g,e,g,e,g,e,g,2p,e,g,e,g,e,g,e,g"

            - if:
