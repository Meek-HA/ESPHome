    optimistic: true
    restore_value: true
    initial_value: "1883"
    min_length: 1
    max_length: 5
    icon: mdi:numeric
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 20

  - platform: template
    name: "MQTT Username"
    id: mqtt_username_text
    entity_category: config
    mode: text
    optimistic: true
    restore_value: true
    initial_value: ""
    max_length: 64
    icon: mdi:account-network
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 30

  - platform: template
    name: "MQTT Password"
    id: mqtt_password_text
    entity_category: config
    mode: password
    optimistic: true
    restore_value: true
    initial_value: ""
    max_length: 64
    icon: mdi:form-textbox-password
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 40

  - platform: template
    name: "RTTTL Melody"
    id: rtttl_melody_text
    entity_category: config
    mode: text
    optimistic: true
    restore_value: true
    initial_value: ""
