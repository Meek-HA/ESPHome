      - rtttl.stop
      - if:
          condition:
            lambda: 'return !x.empty();'
          then:
            - rtttl.play: !lambda 'return x;'

button:
  - platform: template
    name: "Save and Reboot"
    id: save_and_reboot_button
    icon: mdi:content-save-alert
    entity_category: config
    on_press:
      - lambda: |-
          ESP_LOGI("save_reboot", "Saving preferences and rebooting...");
          global_preferences->sync();
      - script.execute: apply_mqtt_settings
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("save_reboot", "Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 50

  - platform: template
    name: "Restart MDT3 ESP32"
    id: restart_mdt3_button
    entity_category: config
    icon: mdi:restart
    on_press:
      - lambda: |-
          ESP_LOGI("restart", "Saving all preferences before rebooting...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("restart", "All preferences saved. Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 90

  - platform: template
    name: "Play PWM Tone"
    id: play_buzzer_tone_button
    icon: mdi:play-circle
    entity_category: config
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 40
    on_press:
      - script.execute: play_manual_buzzer_tone

  - platform: template
    name: "Play Selected Melody"
    id: play_selected_melody_button
    icon: mdi:play-circle-outline
    entity_category: config
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 90
