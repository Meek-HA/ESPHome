esphome:
  name: mdt3-esp32
  friendly_name: MDT3 ESP32

  on_boot:
    priority: 700
    then:
      # Lock buttons before Touch IC power cycle
      - lambda: |-
          id(buttons_locked) = true;

      - switch.turn_off: touch_ics_output
      - delay: 5s
      - switch.turn_on: touch_ics_output

      # Keep buttons blocked 1 more second after Touch ICs on
      - delay: 1s

      # Now allow buttons and end buzzer lockout
      - lambda: |-
          id(buttons_locked) = false;
          id(buzzer_boot_lockout) = false;

      # Sync LEDs to current output states after boot sequence
      - script.execute: sync_leds_to_outputs

esp32:
  board: esp32dev
  variant: esp32
  framework:
    type: esp-idf

logger:

preferences:
  flash_write_interval: 1min

network:
  enable_ipv6: true

api:
  encryption:
    key: "mSI1MgycJikXY7+cmNSvQH0cRVNGTUy+7iTMfeFyM38="

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  on_connect:
    then:
      - script.execute: apply_mqtt_settings

  ap:
    ssid: "Meek-MDT3"
    password: !secret fallback_ap_password

captive_portal:

web_server:
  port: 80
  version: 3
  local: true
  auth:
    username: "Mistik"
    password: !secret meek_dd__web_password
    type: basic

  sorting_groups:
    - id: network_details_group
      name: "Network Details"
      sorting_weight: 10

    - id: mqtt_details_group
      name: "MQTT Details"
      sorting_weight: 20

    - id: device_details_group
      name: "Device Details"
      sorting_weight: 30

    - id: sensors_control_group
      name: "Sensors and Control"
      sorting_weight: 40

    - id: speaker_group
      name: "Speaker"
      sorting_weight: 50

mqtt:
  id: mqtt_client
  broker: "disabled"
  port: 1883
  username: ""
  password: ""
  enable_on_boot: false
  reboot_timeout: 0s

globals:
  - id: buzzer_boot_lockout
    type: bool
    restore_value: no
    initial_value: "true"

  - id: buttons_locked
    type: bool
    restore_value: no
    initial_value: "false"

script:
  - id: apply_mqtt_settings
    mode: restart
    then:
      - lambda: |-
          id(mqtt_client).disable();

          const std::string broker = id(mqtt_broker_text).state;
          const std::string port_text = id(mqtt_port_text).state;

          if (broker.empty() || port_text.empty()) {
            ESP_LOGE("mqtt_config", "MQTT disabled: broker or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("mqtt_config", "MQTT disabled: port contains non-digit characters.");
              return;
            }

            port_value = (port_value * 10) + (c - '0');

            if (port_value > 65535) {
              ESP_LOGE("mqtt_config", "MQTT disabled: port is outside the valid range.");
              return;
            }
          }

          if (port_value < 1 || port_value > 65535) {
            ESP_LOGE("mqtt_config", "MQTT disabled: port must be between 1 and 65535.");
            return;
          }

          id(mqtt_client).set_broker_address(broker);
          id(mqtt_client).set_broker_port(static_cast<uint16_t>(port_value));
          id(mqtt_client).set_username(id(mqtt_username_text).state);
          id(mqtt_client).set_password(id(mqtt_password_text).state);
          id(mqtt_client).enable();

  # Manual fixed-frequency PWM tone.
  - id: play_manual_buzzer_tone
    mode: restart
    then:
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout) && id(buzzer_pwm_volume).state > 0;'
          then:
            - rtttl.stop

            - output.turn_on: buzzer_output

            - output.ledc.set_frequency:
                id: buzzer_output
                frequency: !lambda 'return id(buzzer_pwm_frequency).state;'

            - output.set_level:
                id: buzzer_output
                level: !lambda |-
                  return id(buzzer_pwm_volume).state / 100.0f;

            - delay: !lambda |-
                return static_cast<uint32_t>(id(buzzer_tone_duration).state);

            - output.turn_off: buzzer_output

  - id: sync_leds_to_outputs
    mode: restart
    then:
      # LED 1
      - if:
          condition:
            switch.is_on: output_1
          then:
            - light.turn_on: led1_on
          else:
            - light.turn_on: led1_off

      # LED 2
      - if:
          condition:
            switch.is_on: output_2
          then:
            - light.turn_on: led2_on
          else:
            - light.turn_on: led2_off

      # LED 3
      - if:
          condition:
            switch.is_on: output_3
          then:
            - light.turn_on: led3_on
          else:
            - light.turn_on: led3_off

text:
  - platform: template
    name: "MQTT Broker"
    id: mqtt_broker_text
    entity_category: config
    mode: text
    optimistic: true
    restore_value: true
    initial_value: "meek-io.com"
    max_length: 64
