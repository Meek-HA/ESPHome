  - platform: template
    name: "Play Entered RTTTL Melody"
    id: play_entered_rtttl_melody_button
    icon: mdi:music-note-plus
    entity_category: config
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 70
    on_press:
      - rtttl.stop
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout);'
          then:
            - if:
                condition:
                  lambda: 'return !id(rtttl_melody_text).state.empty();'
                then:
                  - rtttl.play: !lambda 'return id(rtttl_melody_text).state;'
                else:
                  - logger.log:
                      level: WARN
                      format: "No RTTTL melody entered."

  - platform: template
    name: "Stop Speaker"
    id: stop_buzzer_button
    icon: mdi:stop-circle-outline
    entity_category: config
    web_server:
      sorting_group_id: speaker_group
      sorting_weight: 100
    on_press:
      - rtttl.stop

text_sensor:
  - platform: template
    name: "MQTT Status"
    id: mqtt_status_text
    icon: mdi:cloud-check
    entity_category: diagnostic
    update_interval: 5s
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 5
    lambda: |-
      if (id(mqtt_client).is_connected()) {
        return {"Connected"};
      }
      return {"Disconnected"};

  - platform: template
    name: "ESPHome Version"
    id: esphome_version_text
    icon: mdi:chip
    entity_category: diagnostic
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 10
    lambda: |-
      return {ESPHOME_VERSION};

  - platform: template
    name: "Firmware Build Date"
    id: firmware_build_date_text
    icon: mdi:calendar
    entity_category: diagnostic
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 20
    lambda: |-
      return {__DATE__ " " __TIME__};

  - platform: wifi_info
    bssid:
      name: "BSSID Mac"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 90
    ssid:
      name: "Connected SSID"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 100
    dns_address:
      name: "DNS Server IP"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 87

  - platform: template
    name: "IP Address (IPv4)"
    id: ip_ipv4
    icon: mdi:ip-network
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 80
    lambda: |-
      for (auto &addr : esphome::network::get_ip_addresses()) {
        if (addr.is_set() && addr.is_ip4()) {
          char ip_buf[esphome::network::IP_ADDRESS_BUFFER_SIZE];
          addr.str_to(ip_buf);
          return {std::string(ip_buf)};
        }
      }
      return {"Not Connected"};

  - platform: template
    name: "IP Address (IPv6)"
    id: ip_ipv6
    icon: mdi:ip-network-outline
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 85
    lambda: |-
      for (auto &addr : esphome::network::get_ip_addresses()) {
        if (addr.is_set() && addr.is_ip6()) {
          char ip_buf[esphome::network::IP_ADDRESS_BUFFER_SIZE];
          addr.str_to(ip_buf);
          return {std::string(ip_buf)};
        }
      }
      return {"No IPv6 Address"};

  - platform: template
    name: "Uptime"
    id: device_uptime
    entity_category: diagnostic
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 70
    lambda: |-
      uint32_t total_seconds = id(device_uptime_raw).state;

      uint32_t days = total_seconds / 86400;
      uint32_t hours = (total_seconds % 86400) / 3600;
      uint32_t minutes = (total_seconds % 3600) / 60;
      uint32_t seconds = total_seconds % 60;

      char buf[32];
      snprintf(buf, sizeof(buf), "%lud:%02luh:%02lum:%02lus",
               (unsigned long)days,
               (unsigned long)hours,
               (unsigned long)minutes,
               (unsigned long)seconds);
      return {std::string(buf)};

sensor:
  - platform: wifi_signal
    name: "WiFi Signal (dBm)"
    id: wifi_dbm
    update_interval: 60s
    entity_category: diagnostic
    icon: mdi:wifi
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 50

  - platform: template
    name: "WiFi Signal (%)"
    id: wifi_percentage
    update_interval: 60s
    entity_category: diagnostic
    unit_of_measurement: "%"
    icon: mdi:wifi-strength-4
    lambda: |-
      return min(max(2 * (id(wifi_dbm).state + 100.0f), 0.0f), 100.0f);
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 60

  - platform: uptime
    id: device_uptime_raw
    update_interval: 60s
    internal: true

# ----------------- LED CONFIG -----------------

light:
  - platform: esp32_rmt_led_strip
    name: "LED Strip"
    id: led_strip
    pin: GPIO13
    chipset: SK6812
    num_leds: 3
    channel_colors: GRB
    internal: true
    restore_mode: RESTORE_DEFAULT_ON
    effects:
      - pulse:
          name: "Pulse"
          transition_length: 1s
          update_interval: 1s
          min_brightness: 0%
          max_brightness: 100%

      - lambda:
          name: "Strobe"
          update_interval: 200ms
          lambda: |-
            static bool on = false;
            on = !on;
            auto call = id(led_strip).turn_on();
            call.set_brightness(on ? 1.0f : 0.0f);
            call.set_effect("None");
            call.perform();

      - flicker:
          name: "Flicker"
          intensity: 50%

  - platform: partition
    name: "LED 1 ON"
    id: led1_on
    segments:
      - id: led_strip
        from: 0
        to: 0
    icon: mdi:led-on
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 8

  - platform: partition
    name: "LED 1 OFF"
    id: led1_off
    segments:
      - id: led_strip
        from: 0
        to: 0
    icon: mdi:led-off
    entity_category: config
    restore_mode: RESTORE_DEFAULT_ON
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 9

  - platform: partition
    name: "LED 2 ON"
