logger:
#  level: DEBUG
#  baud_rate: 0  # free hardware UART for DSMR


# UART buses
uart:
  # DSMR P1 UART
  - id: uart_bus
    rx_pin: GPIO23
    baud_rate: 115200
    rx_buffer_size: 1700
  # DFPlayer Mini UART
  # GPIO18 = ESP32 TX -> DFPlayer RX (use a 1k resistor in series)
  # GPIO14 = ESP32 RX -> DFPlayer TX
  - id: uart_dfplayer
    tx_pin: GPIO18
    rx_pin: GPIO14
    baud_rate: 9600

dsmr:
  id: dsmr_hub
  uart_id: uart_bus
  crc_check: true
  max_telegram_length: 1700
  # request_pin: GPIOxx   # only if your hardware supports P1 data request

# DFPlayer Mini MP3 player
dfplayer:
  id: dfplayer_mini
  uart_id: uart_dfplayer
  on_finished_playback:
    then:
      - logger.log: 'DFPlayer playback finished'
      - globals.set:
          id: dfplayer_current_track
          value: '0'

# Globals to track DFPlayer state (the component has no getters)
globals:
  - id: dfplayer_volume
    type: int
    initial_value: '15'
  - id: dfplayer_current_track
    type: int
    initial_value: '0'
  - id: dfplayer_selected_track
    type: int
    initial_value: '1'
  - id: dfplayer_device
    type: int
    initial_value: '2'   # TF_CARD = 2
  - id: dfplayer_eq
    type: int
    initial_value: '0'   # NORMAL = 0
  - id: button_lock_seconds
    type: int
    initial_value: '10'
  # ADDED: the real MQTT password (the text entity only shows "********")
  - id: mqtt_password_real
    type: std::string
    restore_value: true
    initial_value: '""'
  # ADDED: true for 10 s after the first press of "Reset WiFi Settings"
  - id: wifi_reset_armed
    type: bool
    restore_value: no
    initial_value: "false"

# Script that plays the selected track. mode: single means that while it is
# running (play + lock delay), any further call to it - from the physical
# button or the "Play Selected Track" web/HA button - is simply ignored.
# This is what actually blocks the button; a delay: alone inside on_press
# would NOT do this, since each trigger spawns its own independent
# automation run. The delay length comes from the "Button Lock Duration"
# number entity (0-30s, see below) via the button_lock_seconds global.
script:
  - id: play_selected_track
    mode: single
    then:
      - dfplayer.play: !lambda 'return id(dfplayer_selected_track);'
      - globals.set:
          id: dfplayer_current_track
          value: !lambda 'return id(dfplayer_selected_track);'
      - delay: !lambda 'return id(button_lock_seconds) * 1000;'

  # ADDED: applies the MQTT text/select entities to the MQTT client (from the Meek MT3)
  - id: apply_mqtt_settings
    mode: restart
    then:
      - lambda: |-
          static bool applied = false;
          if (applied) {
            return;
          }
          applied = true;

          id(mqtt_client).disable();

          const std::string broker = id(mqtt_broker_text).state;
          const std::string port_text = id(mqtt_port_text).state;
          const std::string security = id(mqtt_security_select).current_option();

          if (broker.empty() || port_text.empty()) {
            ESP_LOGE("mqtt_config", "MQTT disabled: broker or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("mqtt_config", "MQTT disabled: port contains non-digit characters.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("mqtt_config", "MQTT disabled: port is outside the valid range.");
              return;
            }
          }

          if (port_value < 1 || port_value > 65535) {
            ESP_LOGE("mqtt_config", "MQTT disabled: port must be between 1 and 65535.");
            return;
          }

          id(mqtt_client).set_broker_address(broker);
          id(mqtt_client).set_broker_port(static_cast<uint16_t>(port_value));
          id(mqtt_client).set_username(id(mqtt_username_text).state);
