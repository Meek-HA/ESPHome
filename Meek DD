      sorting_group_id: device_details_group
      sorting_weight: 5
    lambda: |-
      std::string mac = get_mac_address();
      std::string id_text = mac.substr(mac.length() - 4);
      for (auto &c : id_text) {
        c = toupper(static_cast<unsigned char>(c));
      }
      return {id_text};

  - platform: template
    name: "ESPHome Version"
    id: esphome_version_text
    icon: mdi:chip
    entity_category: ""
    update_interval: never
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 10
    lambda: |-
      return {ESPHOME_VERSION};

  - platform: template
    name: "Firmware Build Date"
    id: firmware_build_date_text
    icon: mdi:calendar
    entity_category: ""
    update_interval: never
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 20
    lambda: |-
      return {__DATE__ " " __TIME__};

  - platform: debug
    reset_reason:
      entity_category: ""
      name: "Reset Reason"
      web_server:
        sorting_group_id: device_details_group
        sorting_weight: 60

  - platform: template
    name: "Uptime"
    id: device_uptime
    icon: mdi:clock-outline
    entity_category: ""
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 70
    lambda: |-
      uint32_t total_seconds = id(device_uptime_raw).state;
      uint32_t days = total_seconds / 86400;
      uint32_t hours = (total_seconds % 86400) / 3600;
      uint32_t minutes = (total_seconds % 3600) / 60;
      uint32_t seconds = total_seconds % 60;
      char buf[32];
      snprintf(buf, sizeof(buf), "%lud:%02luh:%02lum:%02lus",
               (unsigned long)days, (unsigned long)hours,
               (unsigned long)minutes, (unsigned long)seconds);
      return {std::string(buf)};

button:
  - platform: template
    name: "DFPlayer Play"
    icon: mdi:play
    on_press:
      then:
        - dfplayer.start:

  - platform: template
    name: "DFPlayer Pause"
    icon: mdi:pause
    on_press:
      then:
        - dfplayer.pause:

  - platform: template
    name: "DFPlayer Stop"
    icon: mdi:stop
    on_press:
      then:
        - dfplayer.stop:
        - globals.set:
            id: dfplayer_current_track
            value: '0'

  - platform: template
    name: "DFPlayer Next"
    icon: mdi:skip-next
    on_press:
      then:
        - dfplayer.play_next:
        - globals.set:
            id: dfplayer_current_track
            value: !lambda 'return id(dfplayer_current_track) + 1;'

  - platform: template
    name: "DFPlayer Previous"
    icon: mdi:skip-previous
    on_press:
      then:
        - dfplayer.play_previous:
        - globals.set:
            id: dfplayer_current_track
            value: !lambda 'return max(0, id(dfplayer_current_track) - 1);'

  - platform: template
    name: "DFPlayer Volume Up"
    icon: mdi:volume-plus
    on_press:
      then:
        - dfplayer.volume_up:
        - globals.set:
            id: dfplayer_volume
            value: !lambda 'return min(30, id(dfplayer_volume) + 1);'

  - platform: template
    name: "DFPlayer Volume Down"
    icon: mdi:volume-minus
    on_press:
      then:
        - dfplayer.volume_down:
        - globals.set:
            id: dfplayer_volume
            value: !lambda 'return max(0, id(dfplayer_volume) - 1);'

  - platform: template
    name: "DFPlayer Play Selected Track"
    icon: mdi:play-circle
    on_press:
      then:
        - script.execute: play_selected_track

  - platform: template
    name: "Save and Reboot"
    id: save_and_reboot_button
    discovery: false
    icon: mdi:content-save-alert
    entity_category: ""
    on_press:
      - lambda: |-
          ESP_LOGI("save_reboot", "Saving preferences and rebooting...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("save_reboot", "Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 50

  - platform: template
    name: "Reset WiFi Settings"
    id: reset_wifi_settings_button
    discovery: false
    icon: mdi:wifi-cog
    entity_category: ""
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 110
    on_press:
      - if:
          condition:
            lambda: 'return id(wifi_reset_armed);'
          then:
            - script.stop: wifi_reset_arm_timer
            - lambda: |-
                ESP_LOGW("wifi_reset", "Confirmed. Forgetting saved WiFi settings...");
                const uint32_t hash_with_sta = App.get_config_version_hash();
                const uint32_t hash_without_sta = 88491487UL;
                const uint32_t keys[4] = {hash_with_sta, hash_with_sta + 1,
                                          hash_without_sta, hash_without_sta + 1};
                for (uint32_t key : keys) {
                  auto pref = global_preferences->make_preference<uint8_t>(key, true);
                  uint8_t invalid = 0;
                  pref.save(&invalid);
                }
                global_preferences->sync();
            - delay: 500ms
            - lambda: |-
                ESP_LOGW("wifi_reset", "WiFi settings forgotten. Rebooting now...");
                esp_restart();
          else:
            - logger.log:
                level: WARN
                format: "WiFi reset armed. Press the button again within 10 seconds to confirm."
            - script.execute: wifi_reset_arm_timer

  - platform: template
    name: "Restart Meek DD"
    id: restart_meek_dd_button
    entity_category: ""
    icon: mdi:restart
    on_press:
      - lambda: |-
          ESP_LOGI("restart", "Saving all preferences before rebooting...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("restart", "All preferences saved. Rebooting now...");
          esp_restart();
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 90

  - platform: template
    name: "Reset Settings"
    id: reset_settings_button
    discovery: false
    icon: mdi:restore
    entity_category: ""
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 95
    on_press:
      - text.set:
          id: mqtt_broker_text
          value: "mqtt.meek-io.com"
      - text.set:
          id: mqtt_port_text
          value: "1883"
      - text.set:
          id: mqtt_username_text
          value: ""
      - select.set:
          id: mqtt_security_select
          option: "MQTT (Unsecure)"
      - select.set:
          id: dsmr_variant_select
          option: "DSMR 4/5 (115200 8N1, CRC)"
      - number.set:
          id: dfplayer_volume_number
          value: 15
      - number.set:
          id: dfplayer_select_track_number
          value: 1
      - number.set:
          id: button_lock_number
          value: 10
      - select.set:
          id: dfplayer_device_select
          option: "TF Card"
      - select.set:
          id: dfplayer_eq_select
          option: "Normal"
      - lambda: |-
          id(mqtt_password_real) = "";
          id(mqtt_password_text).publish_state("");
      - lambda: |-
          ESP_LOGI("reset_settings", "Resetting settings to factory defaults...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("reset_settings", "Rebooting to apply factory defaults...");
          esp_restart();

number:
  - platform: template
    name: "DFPlayer Volume"
    id: dfplayer_volume_number
    icon: mdi:volume-high
    min_value: 0
    max_value: 30
    step: 1
    initial_value: 15
    optimistic: true
    on_value:
      then:
        - dfplayer.set_volume: !lambda 'return static_cast<uint8_t>(x);'
        - globals.set:
            id: dfplayer_volume
            value: !lambda 'return static_cast<int>(x);'

  - platform: template
    name: "DFPlayer Select Track"
    id: dfplayer_select_track_number
    icon: mdi:music-note
    min_value: 1
    max_value: 30
    step: 1
    initial_value: 1
    optimistic: true
    on_value:
      then:
        - globals.set:
            id: dfplayer_selected_track
            value: !lambda 'return static_cast<int>(x);'

  - platform: template
    name: "Button Lock Duration"
    id: button_lock_number
    icon: mdi:timer-lock-outline
    unit_of_measurement: "s"
    min_value: 0
    max_value: 30
    step: 1
    initial_value: 10
    restore_value: true
    optimistic: true
    on_value:
      then:
        - globals.set:
            id: button_lock_seconds
            value: !lambda 'return static_cast<int>(x);'

select:
  - platform: template
    name: "DFPlayer Device"
    id: dfplayer_device_select
    icon: mdi:sd
    optimistic: true
    options:
      - "TF Card"
      - "USB"
    initial_option: "TF Card"
    on_value:
      then:
        - lambda: |-
            if (x == "USB") {
              id(dfplayer_mini).set_device(esphome::dfplayer::USB);
              id(dfplayer_device) = 1;
            } else {
              id(dfplayer_mini).set_device(esphome::dfplayer::TF_CARD);
              id(dfplayer_device) = 2;
            }

  - platform: template
    name: "DFPlayer Equalizer"
    id: dfplayer_eq_select
    icon: mdi:tune
    optimistic: true
    options:
      - "Normal"
      - "Pop"
      - "Rock"
      - "Jazz"
      - "Classic"
      - "Bass"
    initial_option: "Normal"
    on_value:
      then:
        - lambda: |-
            if (x == "Pop") {
              id(dfplayer_mini).set_eq(esphome::dfplayer::POP);
              id(dfplayer_eq) = 1;
            } else if (x == "Rock") {
              id(dfplayer_mini).set_eq(esphome::dfplayer::ROCK);
              id(dfplayer_eq) = 2;
            } else if (x == "Jazz") {
              id(dfplayer_mini).set_eq(esphome::dfplayer::JAZZ);
              id(dfplayer_eq) = 3;
            } else if (x == "Classic") {
              id(dfplayer_mini).set_eq(esphome::dfplayer::CLASSIC);
              id(dfplayer_eq) = 4;
            } else if (x == "Bass") {
              id(dfplayer_mini).set_eq(esphome::dfplayer::BASS);
              id(dfplayer_eq) = 5;
            } else {
              id(dfplayer_mini).set_eq(esphome::dfplayer::NORMAL);
              id(dfplayer_eq) = 0;
            }

  - platform: template
    name: "MQTT Security"
    id: mqtt_security_select
    discovery: false
    entity_category: ""
    icon: mdi:lock-check
    optimistic: true
    restore_value: true
    initial_option: "MQTT (Unsecure)"
    options:
      - "MQTT (Unsecure)"
      - "MQTTS (Secure/TLS)"
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 45

  # DSMR Variant: UART settings only. CRC is always enabled.
  - platform: template
    name: "DSMR Variant"
    id: dsmr_variant_select
    entity_category: ""
    icon: mdi:meter-electric
    optimistic: true
    restore_value: true
    initial_option: "DSMR 4/5 (115200 8N1, CRC)"
    options:
      - "DSMR 4/5 (115200 8N1, CRC)"
      - "DSMR 4/5 no CRC (115200 8N1)"
      - "DSMR 2.2/3 (9600 7N1)"
      - "DSMR 2.2/3 (9600 7E1)"
    on_value:
      - script.execute: apply_dsmr_variant
    web_server:
      sorting_group_id: dsmr_settings_group
      sorting_weight: 10
