# Meek DD: DSMR P1 meter + DFPlayer Mini
#
# MQTT handling ported from the Meek MT3:
#   - runtime-editable broker / port / username / password (web UI + HA)
#   - MQTT Security select (plain TCP or TLS with the Meek MQTT Root CA)
#   - MQTT starts disabled at boot and is configured + enabled by the
#     apply_mqtt_settings script once WiFi is connected
#   - "Save and Reboot" button and "MQTT Status" sensor
#
# "Network Details" and "Device Details" web groups ported from the Meek MT3
# (WiFi / IP info, Reset WiFi Settings, device info, heap, uptime, restart, reset).
#
# REQUIRES: the same patched MQTT component folder as the Meek MT3, at
# <esphome config dir>/components/mqtt (an empty CA certificate forces plain TCP).

# ADDED: loads the patched MQTT component from /config/components/mqtt
external_components:
  - source:
      type: local
      path: components
    components: [mqtt]

esphome:
  name: meek-dd
  friendly_name: Meek DD
  # ADDED: restore masked password display after components are ready
  on_boot:
    priority: 700
    then:
      - delay: 2s
      - lambda: |-
          if (!id(mqtt_password_real).empty()) {
            id(mqtt_password_text).publish_state("********");
          } else {
            id(mqtt_password_text).publish_state("");
          }

esp32:
  variant: esp32
  framework:
    type: esp-idf


# ADDED: needed by the Heap Free, Heap Max Block and Reset Reason entities
debug:
  update_interval: 30s


# Example configuration entry
web_server:
  port: 80
  version: 3
  local: true
  auth:
    username: Meek
    password: Meek-io
    type: basic
  # CHANGED: groups now match the Meek MT3 (Network 10, MQTT 20, Device 30)
  sorting_groups:
    - id: network_details_group
      name: "Network Details"
      sorting_weight: 10
    - id: mqtt_details_group
      name: "MQTT Details"
      sorting_weight: 20
    - id: device_details_group
      name: "Device Details"
      sorting_weight: 30

ota:
  - platform: esphome


wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  # ADDED: configure and enable MQTT once WiFi is up
  on_connect:
    then:
      - script.execute: apply_mqtt_settings
  ap:
    ssid: Meek DD
    # CHANGED: the pasted value was a Markdown link; written here as the plain string
    password: "www.meek-io.com"

mqtt:
  id: mqtt_client
  # Defaults only: the real values come from the MQTT text entities below
  # and are applied at runtime by apply_mqtt_settings.
  broker: mqtt.meek-io.com
  port: 1883
  username: ""
  password: ""
  # CHANGED: was true. MQTT is now enabled by apply_mqtt_settings after WiFi connects.
  enable_on_boot: false
  reboot_timeout: 0s
  discovery: true
  discovery_prefix: homeassistant
  discovery_retain: true
  # ADDED: puts this device's MAC address in the discovery unique ID so it cannot
  # collide with other Meek devices in Home Assistant.
  # WARNING: this changes the unique ID of every entity of this device in Home
  # Assistant (new entities are created, old ones become unavailable, and
  # history / Energy dashboard statistics do not carry over automatically).
