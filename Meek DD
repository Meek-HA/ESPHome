          id(mqtt_client).enable();

  # ADDED: two-step confirmation timer for "Reset WiFi Settings" (from the Meek MT3)
  - id: wifi_reset_arm_timer
    mode: restart
    then:
      - lambda: |-
          id(wifi_reset_armed) = true;
      - component.update: wifi_reset_status_text
      - delay: 10s
      - lambda: |-
          id(wifi_reset_armed) = false;
      - component.update: wifi_reset_status_text

# ADDED: MQTT settings editable from the web UI / Home Assistant (from the Meek MT3).
text:
  - platform: template
    name: "MQTT Broker"
    id: mqtt_broker_text
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: "mqtt.meek-io.com"
    max_length: 64
    icon: mdi:server-network
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 10

  - platform: template
    name: "MQTT Port"
    id: mqtt_port_text
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: "1883"
    min_length: 1
    max_length: 5
    icon: mdi:numeric
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 20

  - platform: template
    name: "MQTT Username"
    id: mqtt_username_text
    entity_category: ""
    mode: text
    optimistic: true
    restore_value: true
    initial_value: ""
    max_length: 64
    icon: mdi:account-network
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 30

  - platform: template
    name: "MQTT Password"
    id: mqtt_password_text
    entity_category: ""
    mode: text
    optimistic: true
    initial_value: ""
    max_length: 64
    icon: mdi:form-textbox-password
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 40
    set_action:
      - lambda: |-
          id(mqtt_password_real) = x;
          if (x.empty()) {
            id(mqtt_password_text).publish_state("");
          } else {
            id(mqtt_password_text).publish_state("********");
          }

# Speaker amplifier enable — GPIO4 HIGH = speaker active
switch:
  - platform: gpio
    pin: GPIO4
    name: "Speaker Amplifier"
    restore_mode: ALWAYS_ON
    icon: mdi:speaker

# --- DFPlayer sensors (visible in web interface + Home Assistant) ---

binary_sensor:
  # Physical button on GPIO16 — plays the selected track on press.
  # Hardware debounce: delayed_on 50ms filters contact bounce.
  # Software lock: script.play_selected_track (mode: single) ignores any
  # re-trigger for the 10 seconds the script is still running.
  - platform: gpio
    pin:
      number: GPIO16
      mode:
        input: true
        pullup: true
      inverted: true
    name: "Play Button"
    filters:
      - delayed_on: 50ms
    on_press:
      then:
        - script.execute: play_selected_track

  # Play state — uses the DFPlayer's is_playing() method
  - platform: template
    id: dfplayer_playing
    name: "DFPlayer Playing"
    device_class: running
    lambda: |-
      return id(dfplayer_mini).is_playing();

