external_components:
  - source:
      type: local
      path: components
    components: [mqtt]

esphome:
  name: meek-dd
  friendly_name: Meek DD
  on_boot:
    - priority: 700
      then:
        - delay: 2s
        - lambda: |-
            if (!id(mqtt_password_real).empty()) {
              id(mqtt_password_text).publish_state("********");
            } else {
              id(mqtt_password_text).publish_state("");
            }

    - priority: -100
      then:
        - component.update: esphome_version_text
        - component.update: firmware_build_date_text
        - component.update: device_id_text
        - component.update: wifi_reset_status_text
        - text_sensor.template.publish:
            id: mqtt_status_text
            state: "Disconnected"
        - script.execute: apply_dsmr_variant

esp32:
  variant: esp32
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_ESP_TASK_WDT_TIMEOUT_S: "15"

debug:
  update_interval: 30s

preferences:
  flash_write_interval: 1min

web_server:
  port: 80
  version: 3
  local: true
  auth:
    username: Meek
    password: Meek-io
    type: basic
  sorting_groups:
    - id: network_details_group
      name: "Network Details"
      sorting_weight: 10
    - id: mqtt_details_group
      name: "MQTT Details"
      sorting_weight: 20
    - id: device_details_group
      name: "Device Details"
      sorting_weight: 30
    - id: dsmr_settings_group
      name: "DSMR Settings"
      sorting_weight: 40

ota:
  - platform: esphome

wifi:
  reboot_timeout: 0s
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  on_connect:
    then:
      - script.execute: apply_mqtt_settings
      - component.update: ip_ipv4
  ap:
    ssid: Meek DD
    password: "www.meek-io.com"

captive_portal:

logger:

mqtt:
  idf_send_async: true
  keepalive: 30s
  id: mqtt_client
  broker: "mqtt.meek-io.com"
  port: 1883
  username: ""
  password: ""
  enable_on_boot: false
  reboot_timeout: 0s
  discovery: true
  discovery_prefix: homeassistant
  discovery_retain: true
  discovery_unique_id_generator: mac
  on_connect:
    - text_sensor.template.publish:
        id: mqtt_status_text
        state: "Connected"
  on_disconnect:
    - text_sensor.template.publish:
        id: mqtt_status_text
        state: "Disconnected"
  certificate_authority: ${mqtt_ca_cert}
  skip_cert_cn_check: false

uart:
  - id: uart_bus
    rx_pin: GPIO23
    baud_rate: 115200
    rx_buffer_size: 1700

  - id: uart_dfplayer
    tx_pin: GPIO18
    rx_pin: GPIO14
    baud_rate: 9600

dsmr:
  id: dsmr_hub
  uart_id: uart_bus
  crc_check: true
  max_telegram_length: 1700

dfplayer:
  id: dfplayer_mini
  uart_id: uart_dfplayer
  on_finished_playback:
    then:
      - logger.log: 'DFPlayer playback finished'
      - globals.set:
          id: dfplayer_current_track
          value: '0'

globals:
  - id: dfplayer_volume
    type: int
    initial_value: '15'

  - id: dfplayer_current_track
    type: int
    initial_value: '0'

  - id: dfplayer_selected_track
    type: int
    initial_value: '1'

  - id: dfplayer_device
    type: int
    initial_value: '2'

  - id: dfplayer_eq
    type: int
    initial_value: '0'

  - id: button_lock_seconds
    type: int
    initial_value: '10'

  - id: mqtt_password_real
    type: std::string
    restore_value: true
    initial_value: '""'

  - id: wifi_reset_armed
    type: bool
    restore_value: no
    initial_value: "false"

script:
  - id: play_selected_track
    mode: single
    then:
      - dfplayer.play: !lambda 'return id(dfplayer_selected_track);'
      - globals.set:
          id: dfplayer_current_track
          value: !lambda 'return id(dfplayer_selected_track);'
      - delay: !lambda 'return id(button_lock_seconds) * 1000;'

  # DSMR UART settings. CRC is permanently enabled.
  - id: apply_dsmr_variant
    mode: restart
    then:
      - lambda: |-
          const std::string variant = id(dsmr_variant_select).current_option();

          uint32_t baud = 115200;
          uint8_t data_bits = 8;
          auto parity = esphome::uart::UART_CONFIG_PARITY_NONE;

          if (variant == "DSMR 4/5 (115200 8N1, CRC)") {
            // Default settings: 115200 8N1
          } else if (variant == "DSMR 4/5 no CRC (115200 8N1)") {
            // Same UART settings. CRC remains enabled.
          } else if (variant == "DSMR 2.2/3 (9600 7N1)") {
            baud = 9600;
            data_bits = 7;
          } else if (variant == "DSMR 2.2/3 (9600 7E1)") {
            baud = 9600;
            data_bits = 7;
            parity = esphome::uart::UART_CONFIG_PARITY_EVEN;
          }

          id(uart_bus).set_baud_rate(baud);
          id(uart_bus).set_data_bits(data_bits);
          id(uart_bus).set_parity(parity);
          id(uart_bus).load_settings(false);

          ESP_LOGI("dsmr_config",
                   "Variant '%s': %u baud, %u data bits, CRC permanently ON",
                   variant.c_str(), (unsigned) baud, (unsigned) data_bits);

  - id: apply_mqtt_settings
    mode: restart
    then:
      - lambda: |-
          static bool applied = false;
          if (applied) {
            return;
          }
          applied = true;

          id(mqtt_client).disable();

          const std::string broker = id(mqtt_broker_text).state;
          const std::string port_text = id(mqtt_port_text).state;
          const std::string security = id(mqtt_security_select).current_option();

          if (broker.empty() || port_text.empty()) {
            ESP_LOGE("mqtt_config", "MQTT disabled: broker or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("mqtt_config", "MQTT disabled: port contains non-digit characters.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("mqtt_config", "MQTT disabled: port is outside the valid range.");
              return;
            }
          }

          if (port_value < 1 || port_value > 65535) {
            ESP_LOGE("mqtt_config", "MQTT disabled: port must be between 1 and 65535.");
            return;
          }

          id(mqtt_client).set_broker_address(broker);
          id(mqtt_client).set_broker_port(static_cast<uint16_t>(port_value));
          id(mqtt_client).set_username(id(mqtt_username_text).state);
          id(mqtt_client).set_password(id(mqtt_password_real));

          if (security == "MQTTS (Secure/TLS)") {
            static std::string MQTT_CA_CERT;
            if (MQTT_CA_CERT.empty()) {
              const char *raw = R"CERT(${mqtt_ca_cert})CERT";
              bool at_line_start = true;
              for (const char *c = raw; *c != '\0'; c++) {
                if (*c == '\n') {
                  at_line_start = true;
                } else if (at_line_start && (*c == ' ' || *c == '\t' || *c == '\r')) {
                  continue;
                } else {
                  at_line_start = false;
                }
                MQTT_CA_CERT += *c;
              }
            }

            id(mqtt_client).set_ca_certificate(MQTT_CA_CERT.c_str());
            id(mqtt_client).set_skip_cert_cn_check(false);
            ESP_LOGI("mqtt_config", "MQTTS enabled: TLS will be used.");
          } else {
            id(mqtt_client).set_ca_certificate("");
            id(mqtt_client).set_skip_cert_cn_check(true);
            ESP_LOGI("mqtt_config", "MQTT enabled: unencrypted connection will be used.");
          }

          id(mqtt_client).enable();

  - id: wifi_reset_arm_timer
    mode: restart
    then:
      - lambda: |-
          id(wifi_reset_armed) = true;
      - component.update: wifi_reset_status_text
      - delay: 10s
      - lambda: |-
          id(wifi_reset_armed) = false;
      - component.update: wifi_reset_status_text

