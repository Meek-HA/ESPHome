        case 1: return std::string("USB");
        case 2: return std::string("TF Card");
        default: return std::string("Unknown");
      }

  - platform: template
    id: dfplayer_eq_sensor
    name: "DFPlayer Equalizer"
    icon: mdi:tune
    update_interval: 5s
    lambda: |-
      switch (id(dfplayer_eq)) {
        case 0: return std::string("Normal");
        case 1: return std::string("Pop");
        case 2: return std::string("Rock");
        case 3: return std::string("Jazz");
        case 4: return std::string("Classic");
