  # ADDED (Network Details): WiFi info, from the Meek MT3
  - platform: wifi_info
    bssid:
      entity_category: ""
      name: "BSSID Mac"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 90
    ssid:
      entity_category: ""
      name: "Connected SSID"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 100
    dns_address:
      entity_category: ""
      name: "DNS Server IP"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 87

  - platform: template
    name: "IP Address (IPv4)"
    id: ip_ipv4
    icon: mdi:ip-network
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 80
    lambda: |-
      for (auto &addr : esphome::network::get_ip_addresses()) {
        if (addr.is_set() && addr.is_ip4()) {
          char ip_buf[esphome::network::IP_ADDRESS_BUFFER_SIZE];
          addr.str_to(ip_buf);
          return {std::string(ip_buf)};
