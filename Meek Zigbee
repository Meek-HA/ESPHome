# Board: Generic ESP32 Board (Generic)
# Device: Meek Zigbee (derived from Meek MT3)
#
# CHANGES vs. previous version (MQTT discovery / Home Assistant visibility):
#   1. Removed the native "api:" block (HA is connected via MQTT only) -> frees heap.
#   2. mqtt: discovery options set explicitly (retained discovery, HA prefix,
#      birth/will messages) so HA always gets and re-gets the config topics.
#   3. apply_mqtt_settings waits 5 s before enabling MQTT, so the boot load settles
#      before the discovery burst of ~70 entities.
#   4. The Zigbee TCP client is parked at boot and only started after MQTT is
#      connected (+10 s settle time), with a 30 s fallback if MQTT never connects.
#      This keeps the TCP link from competing with the discovery burst.

substitutions:
  # Default TCP server and port. Both can be changed at runtime from the web UI
  # ("Zigbee Server" / "Zigbee Port"); these are only the factory defaults.
  zigbee_host: zigbee.meek-io.com
  zigbee_port: "6638"
  # UART speed to the E72-2G4M20S1E (must match the coordinator firmware)
  zigbee_baud: "115200"
  # Default listening port in Zigbee Server mode. In use at power-up until the saved
  # mode is applied, and the fallback if "Zigbee Port" is invalid. At runtime the
  # server listens on the port entered in "Zigbee Port".
  zigbee_server_port: "8888"

external_components:
  # Patched MQTT component from /config/components/mqtt
  # (an empty CA certificate forces plain TCP instead of TLS)
  - source:
      type: local
      path: components
    components: [mqtt]
  # UART-over-TCP components (uart_tcp_client, uart_tcp_server, uart_bridge)
  - source:
      type: git
      url: https://github.com/nebulous/esphome-uart-link

# NOTE: "api:" removed on purpose (Home Assistant uses MQTT only).
# Side effect: "esphome logs" over WiFi no longer works; use the web UI log
# view (web_server v3) or the serial port instead.

ota:
  - platform: esphome

wifi:
  reboot_timeout: 0s
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  on_connect:
    then:
      - script.execute: apply_zigbee_settings
      - script.execute: zigbee_apply_mode_boot
      - script.execute: apply_mqtt_settings
  ap:
    ssid: Meek Zigbee Fallback Hotspot
    password: "[www.meek-io.com](https://www.meek-io.com)"
captive_portal:

esphome:
  name: meek-zigbee
  friendly_name: Meek Zigbee
  name_add_mac_suffix: false

  on_boot:
    priority: 700
    then:
      # NEW: park the Zigbee TCP client until MQTT is up (see zigbee_apply_mode_boot).
      # WiFi is not connected yet at this point, so nothing is lost by doing this.
      - lambda: |-
          id(zigbee_uart).set_reconnect_interval(UINT32_MAX);

      # LEDs light up one by one in red (runs in parallel with the rest)
      - script.execute: led_boot_sequence
      - delay: 1s
      - lambda: |-
          id(buzzer_boot_lockout) = false;

      # Restore masked password display after components are ready
      - delay: 2s
      - lambda: |-
          if (!id(mqtt_password_real).empty()) {
            id(mqtt_password_text).publish_state("********");
          } else {
            id(mqtt_password_text).publish_state("");
          }

esp32:
  board: esp32dev
  variant: esp32
  framework:
    type: esp-idf

logger:
  logs:
    # The idle client logs every dropped chunk at DEBUG while in Server mode
    uart_tcp_client: INFO

debug:
  update_interval: 30s

preferences:
  flash_write_interval: 1min

network:
  enable_ipv6: true

# Hardware UART to the E72-2G4M20S1E (ESP32 TX = GPIO32, ESP32 RX = GPIO33)
uart:
  - id: zigbee_hw_uart
    tx_pin: GPIO32
    rx_pin: GPIO33
    baud_rate: ${zigbee_baud}
    rx_buffer_size: 2048

# Zigbee serial link: outbound TCP client that acts as a UART.
# host/port below are the defaults; the web UI values override them at boot
# (see the apply_zigbee_settings script).
uart_tcp_client:
  id: zigbee_uart
  host: ${zigbee_host}
  port: ${zigbee_port}
  rx_buffer_size: 4096
  reconnect_interval: 5s
  # Zigbee links can be quiet for long periods, so silence must not force a reconnect.
  # "0s" did not disable stall detection on the device (it reconnected after 20 ms),
  # so a long timeout is used instead.
  stall_timeout: 600s

# Zigbee serial link: TCP server that acts as a UART (Zigbee Server mode).
# Only one of client / server is active at a time (see the Zigbee Client Mode /
# Zigbee Server Mode switches and the zigbee_apply_mode script). The inactive
# side is parked at runtime: the client stops reconnecting, and the server stops
# listening. The port below is only the initial one; zigbee_apply_mode restarts
# the listener on the port entered in "Zigbee Port".
uart_tcp_server:
  id: zigbee_server
  port: ${zigbee_server_port}
  # One Zigbee host at a time; a new connection replaces a stale one
  max_clients: 1
  client_mode: exclusive

# Transparent byte bridge: E72 serial port <-> TCP client / TCP server
uart_bridge:
  uarts: [zigbee_hw_uart, zigbee_uart, zigbee_server]
  buffer_size: 512

time:
  - platform: sntp
    id: sntp_time



web_server:
  port: 80
  version: 3
  local: true
  auth:
    username: "Meek"
    password: Meek-io
    type: basic
  sorting_groups:
    - id: network_details_group
      name: "Network Details"
      sorting_weight: 10
    - id: mqtt_details_group
      name: "MQTT Details"
      sorting_weight: 20
    - id: zigbee_details_group
      name: "Zigbee Details"
      sorting_weight: 25
    - id: device_details_group
      name: "Device Details"
      sorting_weight: 30
    - id: sensors_control_group
      name: "Sensors and Control"
      sorting_weight: 40
    - id: speaker_group
      name: "Speaker"
      sorting_weight: 50

mqtt:
  id: mqtt_client
  broker: "mqtt.meek-io.com"
  port: 1883
  username: ""
  password: ""
  enable_on_boot: false
  reboot_timeout: 0s
  # Home Assistant MQTT discovery. discovery / discovery_retain / discovery_prefix
  # are the ESPHome defaults, set explicitly here so it is obvious they matter:
  # retained discovery topics survive an HA restart and a broker restart.
  # discovery_prefix MUST match the MQTT integration's prefix in Home Assistant.
  discovery: true
  discovery_retain: true
  discovery_prefix: homeassistant
  # ROOT CAUSE FIX: the default ("legacy") unique ID is only "ESP" + type + name
  # (e.g. ESPbuttonstop_speaker), so it collided with the Meek MT3 device and HA
  # ignored every entity with a shared name. "mac" puts this device's MAC in the ID.
  discovery_unique_id_generator: mac
  # Availability: entities show "unavailable" in HA when the device is offline.
  birth_message:
    topic: meek-zigbee/status
    payload: online
    retain: true
  will_message:
    topic: meek-zigbee/status
    payload: offline
    retain: true
