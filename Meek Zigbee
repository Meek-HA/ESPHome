            id(mqtt_client).set_ca_certificate("");
            id(mqtt_client).set_skip_cert_cn_check(true);
            ESP_LOGI("mqtt_config", "MQTT enabled: unencrypted connection will be used.");
          }

          id(mqtt_client).enable();

  - id: play_manual_buzzer_tone
    mode: restart
    then:
      - if:
          condition:
            lambda: 'return !id(buzzer_boot_lockout) && id(buzzer_pwm_volume).state > 0;'
          then:
            - rtttl.stop
            - output.turn_on: buzzer_output
            - output.ledc.set_frequency:
                id: buzzer_output
                frequency: !lambda 'return id(buzzer_pwm_frequency).state;'
            - output.set_level:
                id: buzzer_output
                level: !lambda |-
                  return id(buzzer_pwm_volume).state / 100.0f;
            - delay: !lambda |-
                return static_cast<uint32_t>(id(buzzer_tone_duration).state);
            - output.turn_off: buzzer_output

  - id: wifi_reset_arm_timer
    mode: restart
    then:
      - lambda: |-
          id(wifi_reset_armed) = true;
      - component.update: wifi_reset_status_text
      - delay: 10s
      - lambda: |-
          id(wifi_reset_armed) = false;
      - component.update: wifi_reset_status_text

  # Applies the user-set Zigbee TCP server and port once per boot.
  # NOTE: assumes uart_tcp_client exposes set_host() / set_port().
  - id: apply_zigbee_settings
    mode: restart
    then:
      - lambda: |-
          static bool applied = false;
          if (applied) {
            return;
          }
          applied = true;

          static std::string host;
          host = id(zigbee_host_text).state;
          const std::string port_text = id(zigbee_port_text).state;

          if (host.empty() || port_text.empty()) {
            ESP_LOGE("zigbee_config", "Host or port is empty, keeping built-in defaults.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("zigbee_config", "Port contains non-digit characters, keeping defaults.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("zigbee_config", "Port is outside the valid range, keeping defaults.");
              return;
            }
          }

          if (port_value < 1) {
            ESP_LOGE("zigbee_config", "Port must be between 1 and 65535, keeping defaults.");
            return;
          }

          id(zigbee_uart).set_host(host.c_str());
          id(zigbee_uart).set_port(static_cast<uint16_t>(port_value));
          ESP_LOGI("zigbee_config", "Zigbee TCP target set to %s:%u", host.c_str(), (unsigned) port_value);

  # Applies the current Zigbee Server / Port values and forces a reconnect.
  # Unlike apply_zigbee_settings, this runs every time it is called.
  # NOTE: assumes uart_tcp_client exposes disconnect() (see ASSUMED below).
  - id: zigbee_connect_now
    mode: restart
    then:
      - lambda: |-
          if (id(zigbee_mode) != "client") {
            ESP_LOGW("zigbee_config", "Connect ignored: not in Client mode.");
            return;
          }

          // Two buffers, alternated, so the pointer given to the component
          // is never freed while it may still be in use.
          static std::string bufs[2];
          static uint8_t idx = 0;

          const std::string host = id(zigbee_host_text).state;
          const std::string port_text = id(zigbee_port_text).state;

          if (host.empty() || port_text.empty()) {
            ESP_LOGE("zigbee_config", "Connect aborted: host or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("zigbee_config", "Connect aborted: port contains non-digit characters.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("zigbee_config", "Connect aborted: port is outside the valid range.");
              return;
            }
          }
          if (port_value < 1) {
            ESP_LOGE("zigbee_config", "Connect aborted: port must be between 1 and 65535.");
            return;
          }

          idx ^= 1;
          bufs[idx] = host;
          id(zigbee_uart).set_host(bufs[idx].c_str());
          id(zigbee_uart).set_port(static_cast<uint16_t>(port_value));
          ESP_LOGI("zigbee_config", "Connecting to %s:%u", bufs[idx].c_str(), (unsigned) port_value);

          // disconnect_() is protected in uart_tcp_client. A derived struct
          // re-exposes it, so we can call it without editing the component.
          struct ZigbeeAccess : esphome::uart_tcp_client::UARTTCPClientComponent {
            using esphome::uart_tcp_client::UARTTCPClientComponent::disconnect_;
          };
          auto drop_connection = &ZigbeeAccess::disconnect_;
          (id(zigbee_uart).*drop_connection)();

  # Switches the Zigbee link between Client, Server and none.
  # mode: "client" | "server" | "none". Only one side is ever active.
  - id: zigbee_apply_mode
    mode: restart
    parameters:
      mode: string
    then:
      - lambda: |-
          id(zigbee_mode) = mode;
          const bool want_client = (mode == "client");
          const bool want_server = (mode == "server");

          // --- Client side ---
          if (want_client) {
            // Let the client (re)connect automatically again
            id(zigbee_uart).set_reconnect_interval(5000);
          } else {
            // Never auto-reconnect, then drop the current socket / connect attempt.
            // disconnect_() is protected, so a derived struct re-exposes it.
            id(zigbee_uart).set_reconnect_interval(UINT32_MAX);
            struct ZigbeeAccess : esphome::uart_tcp_client::UARTTCPClientComponent {
              using esphome::uart_tcp_client::UARTTCPClientComponent::disconnect_;
            };
            auto drop_connection = &ZigbeeAccess::disconnect_;
            (id(zigbee_uart).*drop_connection)();
          }

          // --- Server side ---
          // port_ and tcp_server_ are protected in uart_tcp_server, so a derived
          // struct re-exposes them.
          using esphome::uart_tcp_server::UARTTCPServerComponent;
          struct ServerAccess : UARTTCPServerComponent {
            using UARTTCPServerComponent::port_;
            using UARTTCPServerComponent::tcp_server_;
            using UARTTCPServerComponent::accept_client_;
          };
          UARTTCPServerComponent *srv = id(zigbee_server);
          AsyncServer *&tcp = srv->*(&ServerAccess::tcp_server_);
          uint16_t &listen_port = srv->*(&ServerAccess::port_);

          if (want_server) {
            // Listening port = the value entered in "Zigbee Port"
            const std::string port_text = id(zigbee_port_text).state;
            uint32_t port_value = 0;
            bool port_ok = !port_text.empty();
            for (char c : port_text) {
              if (c < '0' || c > '9') {
                port_ok = false;
                break;
              }
              port_value = (port_value * 10) + (c - '0');
              if (port_value > 65535) {
                port_ok = false;
                break;
              }
            }
            if (port_value < 1) {
              port_ok = false;
            }
            if (!port_ok) {
              port_value = ${zigbee_server_port};
              ESP_LOGE("zigbee_config", "Invalid Zigbee Port, listening on default port %u", (unsigned) port_value);
            }

            if (tcp == nullptr || listen_port != static_cast<uint16_t>(port_value)) {
              // Different port: stop the old listener and create a new one. The old
              // AsyncServer object is deliberately not deleted, because the TCP task
              // may still hold a pointer to it.
              if (tcp != nullptr) {
                tcp->end();
              }
              listen_port = static_cast<uint16_t>(port_value);
              tcp = new AsyncServer(listen_port);
              static auto accept = &ServerAccess::accept_client_;
              tcp->onClient(
                  [](void *arg, AsyncClient *client) {
                    (static_cast<UARTTCPServerComponent *>(arg)->*accept)(client);
                  },
                  srv);
            }
            tcp->begin();  // does nothing if it is already listening
            srv->set_idle_timeout(0);
            ESP_LOGI("zigbee_config", "Zigbee server listening on port %u", (unsigned) listen_port);
          } else {
            // Stop listening, and an idle timeout of 1 ms makes the server close
            // any client that is still connected.
            if (tcp != nullptr) {
              tcp->end();
            }
            srv->set_idle_timeout(1);
          }

          // Keep both switches consistent (publish_state does not trigger their actions)
          id(zigbee_client_mode_switch).publish_state(want_client);
          id(zigbee_server_mode_switch).publish_state(want_server);
          ESP_LOGI("zigbee_config", "Zigbee mode: %s", mode.c_str());
      - if:
          condition:
            lambda: 'return id(zigbee_mode) == "client";'
          then:
            # Applies the Zigbee Server / Port values and connects
            - script.execute: zigbee_connect_now

  # Applies the saved Zigbee mode once per boot (after WiFi is up).
  # CHANGED: waits until MQTT is connected (so the discovery burst is not competing
  # with the Zigbee TCP link), then 10 s more. If MQTT never connects (broker down,
  # wrong settings) it starts anyway after 30 s, so Zigbee never depends on MQTT.
  - id: zigbee_apply_mode_boot
    mode: restart
    then:
      - wait_until:
          condition:
            mqtt.connected:
          timeout: 30s
      - delay: 10s
      - if:
          condition:
            lambda: |-
              static bool applied = false;
              if (applied) {
                return false;
              }
              applied = true;
              return true;
          then:
            - script.execute:
                id: zigbee_apply_mode
                mode: !lambda 'return id(zigbee_mode);'

  # Boot sequence. LED 1..4 light up one by one in red at 25% (600 ms apart).
  # Skipped if the LED Strip light is on (e.g. an effect is running).
  - id: led_boot_sequence
    mode: single
    then:
      - delay: 500ms
      - if:
          condition:
            light.is_off: led_strip
          then:
            - light.turn_on:
                id: led1_status
                red: 100%
                green: 0%
                blue: 0%
                brightness: 25%
                transition_length: 0s
            - delay: 600ms
            - light.turn_on:
                id: led2_status
                red: 100%
                green: 0%
                blue: 0%
                brightness: 25%
                transition_length: 0s
            - delay: 600ms
            - light.turn_on:
                id: led3_status
                red: 100%
                green: 0%
                blue: 0%
                brightness: 25%
                transition_length: 0s
            - delay: 600ms
            - light.turn_on:
                id: led4_status
                red: 100%
                green: 0%
                blue: 0%
                brightness: 25%
                transition_length: 0s
      - lambda: |-
          id(led_boot_done) = true;

  # MQTT connected. All 4 LEDs fade from red to white at 25% over 2 s.
  # Waits for the boot sequence to finish, and is skipped while an effect runs.
  - id: led_mqtt_connected
    mode: restart
    then:
      - wait_until:
          condition:
            lambda: 'return id(led_boot_done);'
          timeout: 10s
      - if:
          condition:
            light.is_off: led_strip
          then:
            - light.turn_on:
                id: led1_status
                red: 100%
                green: 100%
                blue: 100%
                brightness: 25%
                transition_length: 2s
            - light.turn_on:
                id: led2_status
                red: 100%
                green: 100%
                blue: 100%
                brightness: 25%
                transition_length: 2s
            - light.turn_on:
                id: led3_status
                red: 100%
                green: 100%
                blue: 100%
                brightness: 25%
                transition_length: 2s
            - light.turn_on:
                id: led4_status
                red: 100%
                green: 100%
                blue: 100%
                brightness: 25%
                transition_length: 2s

