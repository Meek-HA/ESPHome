    pin: GPIO13
    chipset: SK6812
    num_leds: 4
    channel_colors: GRB
    icon: mdi:led-strip-variant
    entity_category: ""
    restore_mode: ALWAYS_OFF
    web_server:
      sorting_group_id: sensors_control_group
      sorting_weight: 6
    effects:
      - pulse:
          name: "Pulse"
          transition_length: 1s
          update_interval: 1s
          min_brightness: 0%
          max_brightness: 100%
      - strobe:
          name: "Strobe"
          colors:
            - state: true
              brightness: 100%
              duration: 200ms
            - state: false
              duration: 200ms
      - flicker:
          name: "Flicker"
          intensity: 5%
      - addressable_scan:
          name: "Scan"
          move_interval: 150ms
          scan_width: 1
      - addressable_rainbow:
          name: "Rainbow"
          speed: 10
          width: 3
      - addressable_color_wipe:
          name: "Color Wipe"
          colors:
            - red: 100%
              green: 0%
              blue: 0%
              num_leds: 1
            - red: 0%
              green: 100%
              blue: 0%
              num_leds: 1
            - red: 0%
              green: 0%
              blue: 100%
              num_leds: 1
          add_led_interval: 200ms
          reverse: false
      - addressable_twinkle:
