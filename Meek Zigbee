switch:
  # Zigbee link mode. Only one of these two can be on; turning one on turns the
  # other off. Both off = Zigbee link closed. The state is restored from the
  # zigbee_mode global after WiFi connects, hence restore_mode: DISABLED.
  - platform: template
    id: zigbee_client_mode_switch
    name: "Zigbee Client Mode"
    icon: mdi:lan-connect
    entity_category: ""
    optimistic: true
    restore_mode: DISABLED
    web_server:
      sorting_group_id: zigbee_details_group
      sorting_weight: 1
    turn_on_action:
      - script.execute:
          id: zigbee_apply_mode
          mode: "client"
    turn_off_action:
      - script.execute:
          id: zigbee_apply_mode
          mode: "none"

  - platform: template
    id: zigbee_server_mode_switch
    name: "Zigbee Server Mode"
    icon: mdi:server-network
    entity_category: ""
    optimistic: true
    restore_mode: DISABLED
    web_server:
      sorting_group_id: zigbee_details_group
      sorting_weight: 2
    turn_on_action:
      - script.execute:
          id: zigbee_apply_mode
          mode: "server"
    turn_off_action:
      - script.execute:
          id: zigbee_apply_mode
          mode: "none"

  # E72 BSL pin (GPIO27): switch ON = pin driven LOW = bootloader requested
  - platform: gpio
    id: zigbee_bsl_pin
    name: "Zigbee BSL Pin"
    pin:
      number: GPIO27
      inverted: true
    restore_mode: ALWAYS_OFF
    entity_category: ""
    icon: mdi:chip
    web_server:
      sorting_group_id: zigbee_details_group
      sorting_weight: 50

  # E72 reset pin (GPIO16): switch ON = pin driven LOW = chip held in reset
  - platform: gpio
    id: zigbee_reset_pin
    name: "Zigbee Reset Pin"
    pin:
      number: GPIO16
      inverted: true
    restore_mode: ALWAYS_OFF
    entity_category: ""
    icon: mdi:restart-alert
    web_server:
      sorting_group_id: zigbee_details_group
      sorting_weight: 60
