globals:
  - id: buzzer_boot_lockout
    type: bool
    restore_value: no
    initial_value: "true"

  - id: wifi_reset_armed
    type: bool
    restore_value: no
    initial_value: "false"

  # true once the red boot sequence has finished
  - id: led_boot_done
    type: bool
    restore_value: no
    initial_value: "false"

  # active Zigbee link mode, survives reboots: "client", "server" or "none"
  - id: zigbee_mode
    type: std::string
    restore_value: true
    initial_value: '"client"'

  - id: mqtt_password_real
    type: std::string
    restore_value: true
    initial_value: '""'

script:
  - id: apply_mqtt_settings
    mode: restart
    then:
      # NEW: let the boot load (LED sequence, UART bridge, WiFi/IPv6 setup) settle
      # before MQTT connects and publishes the discovery burst.
      - delay: 5s
      - lambda: |-
          static bool applied = false;
          if (applied) {
            return;
          }
          applied = true;

          id(mqtt_client).disable();

          const std::string broker = id(mqtt_broker_text).state;
          const std::string port_text = id(mqtt_port_text).state;
          const std::string security = id(mqtt_security_select).current_option();

          if (broker.empty() || port_text.empty()) {
            ESP_LOGE("mqtt_config", "MQTT disabled: broker or port is empty.");
            return;
          }

          uint32_t port_value = 0;
          for (char c : port_text) {
            if (c < '0' || c > '9') {
              ESP_LOGE("mqtt_config", "MQTT disabled: port contains non-digit characters.");
              return;
            }
            port_value = (port_value * 10) + (c - '0');
            if (port_value > 65535) {
              ESP_LOGE("mqtt_config", "MQTT disabled: port is outside the valid range.");
              return;
            }
          }

          if (port_value < 1 || port_value > 65535) {
            ESP_LOGE("mqtt_config", "MQTT disabled: port must be between 1 and 65535.");
            return;
          }

          id(mqtt_client).set_broker_address(broker);
          id(mqtt_client).set_broker_port(static_cast<uint16_t>(port_value));
          id(mqtt_client).set_username(id(mqtt_username_text).state);
          id(mqtt_client).set_password(id(mqtt_password_real));

