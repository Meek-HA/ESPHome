          value: "mqtt.meek-io.com"
      - text.set:
          id: mqtt_port_text
          value: "1883"
      - text.set:
          id: zigbee_host_text
          value: "${zigbee_host}"
      - text.set:
          id: zigbee_port_text
          value: "${zigbee_port}"
      - text.set:
          id: rtttl_melody_text
          value: ""
      - number.set:
          id: buzzer_pwm_frequency
          value: 4000
      - number.set:
          id: buzzer_tone_duration
          value: 100
      - number.set:
          id: buzzer_pwm_volume
          value: 25
      - number.set:
          id: buzzer_volume
          value: 25
      - select.set:
          id: buzzer_melody
          option: "Mario"
      - lambda: |-
          id(mqtt_password_real) = "";
          id(mqtt_password_text).publish_state("");
          id(zigbee_mode) = "client";
      - lambda: |-
          ESP_LOGI("reset_settings", "Resetting settings to factory defaults...");
          global_preferences->sync();
      - delay: 500ms
      - lambda: |-
          ESP_LOGI("reset_settings", "Rebooting to apply factory defaults...");
          esp_restart();

text_sensor:
  - platform: template
    name: "MQTT Status"
    id: mqtt_status_text
    icon: mdi:cloud-check
    entity_category: ""
    update_interval: 5s
    web_server:
      sorting_group_id: mqtt_details_group
      sorting_weight: 5
    lambda: |-
      if (id(mqtt_client).is_connected()) {
        return {"Connected"};
      }
      return {"Disconnected"};

  - platform: template
    name: "Device ID"
    id: device_id_text
    icon: mdi:identifier
    entity_category: ""
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 5
    lambda: |-
      std::string mac = get_mac_address();
      std::string id_text = mac.substr(mac.length() - 4);
      for (auto &c : id_text) {
        c = toupper(static_cast<unsigned char>(c));
      }
      return {id_text};

  - platform: template
    name: "WiFi Reset Status"
    id: wifi_reset_status_text
    icon: mdi:wifi-alert
    entity_category: ""
    update_interval: 5s
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 111
    lambda: |-
      if (id(wifi_reset_armed)) {
        return {"Press 'Reset WiFi Settings' again within 10 s to confirm"};
      }
      return {"Idle"};

  - platform: template
    name: "ESPHome Version"
    id: esphome_version_text
    icon: mdi:chip
    entity_category: ""
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 10
    lambda: |-
      return {ESPHOME_VERSION};

  - platform: template
    name: "Firmware Build Date"
    id: firmware_build_date_text
    icon: mdi:calendar
    entity_category: ""
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 20
    lambda: |-
      return {__DATE__ " " __TIME__};

  - platform: debug
    reset_reason:
      entity_category: ""
      name: "Reset Reason"
      web_server:
        sorting_group_id: device_details_group
        sorting_weight: 60

  - platform: wifi_info
    bssid:
      entity_category: ""
      name: "BSSID Mac"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 90
    ssid:
      entity_category: ""
      name: "Connected SSID"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 100
    dns_address:
      entity_category: ""
      name: "DNS Server IP"
      icon: mdi:wifi
      web_server:
        sorting_group_id: network_details_group
        sorting_weight: 87

  - platform: template
    name: "IP Address (IPv4)"
    id: ip_ipv4
    icon: mdi:ip-network
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 80
    lambda: |-
      for (auto &addr : esphome::network::get_ip_addresses()) {
        if (addr.is_set() && addr.is_ip4()) {
          char ip_buf[esphome::network::IP_ADDRESS_BUFFER_SIZE];
          addr.str_to(ip_buf);
          return {std::string(ip_buf)};
        }
      }
      return {"Not Connected"};

  - platform: template
    name: "IP Address (IPv6)"
    id: ip_ipv6
    icon: mdi:ip-network-outline
    web_server:
      sorting_group_id: network_details_group
      sorting_weight: 85
    lambda: |-
      for (auto &addr : esphome::network::get_ip_addresses()) {
        if (addr.is_set() && addr.is_ip6()) {
          char ip_buf[esphome::network::IP_ADDRESS_BUFFER_SIZE];
          addr.str_to(ip_buf);
          return {std::string(ip_buf)};
        }
      }
      return {"No IPv6 Address"};

  - platform: template
    name: "Uptime"
    id: device_uptime
    icon: mdi:clock-outline
    entity_category: ""
    update_interval: 60s
    web_server:
      sorting_group_id: device_details_group
      sorting_weight: 70
    lambda: |-
      uint32_t total_seconds = id(device_uptime_raw).state;
      uint32_t days = total_seconds / 86400;
      uint32_t hours = (total_seconds % 86400) / 3600;
      uint32_t minutes = (total_seconds % 3600) / 60;
      uint32_t seconds = total_seconds % 60;
      char buf[32];
      snprintf(buf, sizeof(buf), "%lud:%02luh:%02lum:%02lus",
               (unsigned long)days, (unsigned long)hours,
               (unsigned long)minutes, (unsigned long)seconds);
      return {std::string(buf)};

